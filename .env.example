# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:latest
EMBEDDING_MODEL=bge-m3:latest
OLLAMA_TIMEOUT_SECONDS=300.0
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Vector Store
CHROMA_PERSIST_DIRECTORY=./storage/chroma_db
COLLECTION_NAME=learning_roadmaps

# Application
APP_NAME=AI Learning Assistant
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Cache Configuration
CACHE_TTL_SECONDS=3600